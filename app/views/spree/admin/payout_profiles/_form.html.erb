<div data-hook="admin_payout_profile_form_fields">
  <div data-hook="payout_profile" class="row">
    <div class="col-12 col-md-6">
      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><%= Spree.t(:settings) %></h5>
        </div>
        <div class="card-body">
          <%= f.field_container :type, class: ["form-group"] do %>
            <%= f.label :type, Spree.t(:provider) %>
            <%= f.select(:type, @types, {}, { class: 'select2' }) %>
          <% end %>

          <%= f.field_container :vendor do %>
            <%= f.label :vendor, Spree.t(:vendors) %>
            <%= f.collection_select :vendor_id, Spree::Vendor.all, :id, :name, { prompt: Spree.t('match_choices.none') }, class: 'form-control select2' %>
            <%= f.error_message_on :vendor_id %>
          <% end unless f.object.default? %>

          <%= f.field_container :name, class: ["form-group"] do %>
            <%= f.label :name, Spree.t(:name) %>
            <%= f.text_field :name, class: 'form-control' %>
            <%= f.error_message_on :name %>
            <small class="form-text text-muted">
              <%= raw "Set '<strong>#{Spree::Store.default&.name}</strong>' to mark as default" %>
            </small>
          <% end %>

          <%= f.field_container :bank_account_number, class: ["form-group"] do %>
            <%= f.label :bank_account_number, Spree.t(:bank_account_number) %> <span class="required">*</span>
            <%= f.text_field :bank_account_number, class: 'form-control' %>
            <%= f.error_message_on :bank_account_number %>
          <% end %>

          <%= f.field_container :active, class: ["form-group card card-body"] do %>
            <strong><%= Spree.t(:active) %></strong>
            <div class="radio my-2 form-check">
              <%= f.radio_button :active, true, class: 'form-check-input' %>
              <%= f.label :active_true, Spree.t(:say_yes), class: 'form-check-label' %>
            </div>

            <div class="radio my-2 form-check">
              <%= f.radio_button :active, false, class: 'form-check-input' %>
              <%= f.label :active_false, Spree.t(:say_no), class: 'form-check-label' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><%= Spree.t(:payout_profile_settings) %></h5>
        </div>
        <div class="card-body">
          <div id="preference-settings" data-hook class="form-group">
            <% unless @object.new_record? %>
            <% if preference_fields(@object, f).empty? %>
              <%= Spree.t('no_payout_profile_settings_message') %>
            <% end %>
              <%= preference_fields(@object, f) %>
              <% if @object.respond_to?(:preferences) %>
                <div id="gateway-settings-warning" class="info warning"><%= Spree.t(:provider_settings_warning) %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
