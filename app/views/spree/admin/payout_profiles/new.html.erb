<% content_for :page_title do %>
  <%= link_to Spree.t(:payout_profiles), spree.admin_payout_profiles_path %> /
  <%= Spree.t(:new) %>
<% end %>

<%= render partial: 'spree/admin/shared/error_messages', locals: { target: @payout_profile } %>

<%= form_for @payout_profile, url: collection_url do |f| %>
  <fieldset>
    <%= render partial: 'form', locals: { f: f } %>
    <%= render partial: 'spree/admin/shared/new_resource_links' %>
  </fieldset>
<% end %>
