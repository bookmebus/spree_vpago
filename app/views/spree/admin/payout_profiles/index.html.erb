<% content_for :page_title do %>
  <%= Spree.t(:payout_profiles) %>
<% end %>

<% content_for :page_actions do %>
  <%= button_link_to Spree.t(:new), new_object_url, class: "btn-success", icon: 'add.svg' %>
<% end if can? :create, Spree::PayoutProfile %>

<% if @payout_profiles.any? %>
<div class="table-responsive border rounded bg-white mb-3">
  <table class="table">
    <thead class="text-muted">
      <tr data-hook="admin_payout_profiles_index_headers">
        <th><%= Spree.t(:name) %></th>
        <th><%= Spree.t(:type) %></th>
        <th><%= Spree.t(:vendor) %></th>
        <th><%= Spree.t(:bank_account_number) %></th>
        <th class="text-center"><%= Spree.t(:active) %></th>
        <th><%= Spree.t(:verified_at) %></th>
        <th><%= Spree.t(:updated_at) %></th>
        <th data-hook="admin_payout_profiles_index_header_actions" class="actions"></th>
      </tr>
    </thead>
    <tbody id="sortVert">
      <% @payout_profiles.each do |profile| %>
        <tr id="<%= spree_dom_id profile %>" data-hook="admin_payout_profiles_index_rows">
          <td>
            <%= profile.name %>
            <% if profile.default? %>
              <div class="badge badge-pill badge-info"><%= Spree.t(:default) %></div>
            <% end %>
          </td>
          <td><%= profile.type&.demodulize %></td>
          <td>
            <%= link_to profile.vendor&.name, edit_admin_vendor_path(profile.vendor) if profile.vendor&.present? %>
          </td>
          <td><%= profile.bank_account_number %></td>
          <td class="text-center"><%= active_badge(profile.active) %></td>
          <td><%= pretty_time(profile.verified_at) %></td>
          <td><%= pretty_time(profile.updated_at) %></td>
          <td data-hook="admin_payout_profiles_index_row_actions" class="actions">
            <span class="d-flex justify-content-end">
              <%= link_to_edit(profile, no_text: true) if can? :edit, profile %>
              <%= link_to_delete(profile, no_text: true) if can? :delete, profile %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% else %>
  <div class="text-center no-objects-found m-5">
    <%= Spree.t(:no_resource_found, resource: plural_resource_name(Spree::PayoutProfile)) %>,
    <%= link_to(Spree.t(:add_one), new_object_url) if can? :create, Spree::PayoutProfile %>!
  </div>
<% end %>

<%= paginate @payout_profiles, theme: 'admin-twitter-bootstrap-4' %>
