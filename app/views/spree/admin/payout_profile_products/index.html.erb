<%= render partial: 'spree/admin/shared/product_tabs', locals: { current: :payout_profile_products } %>

<% content_for :page_actions do %>
  <%= button_link_to Spree.t(:new), new_object_url, class: "btn-success", icon: 'add.svg' if can? :create, Spree::PayoutProfileProduct %>
<% end %>

<% if @product.vendor&.payout_profiles.empty? %>
  <div class="alert alert-warning d-flex justify-content-between align-items-center">
    <span><%= raw "There is no profiles added to <strong>#{@product.vendor&.name}</strong>" %></span>
    <%= button_link_to Spree.t(:add), admin_payout_profiles_url, { icon: 'add.svg', class: 'btn-outline-dark' } %>
  </div>
<% end %>

<div class="alert alert-info">
  Only active & verified profile will receive payout amount.
</div>


<% if @payout_profile_products.any? %>
<div class="table-responsive border rounded bg-white mb-3">
  <table class="table">
    <thead class="text-muted">
      <tr data-hook="admin_payout_profile_products_index_headers">
        <th></th>
        <th><%= Spree.t(:profile) %></th>
        <th class="text-center"><%= Spree.t(:active) %></th>
        <th class="text-center"><%= Spree.t(:verified_at) %></th>
        <th><%= Spree.t(:bank_account_number) %></th>
        <th><%= Spree.t(:created_at) %></th>
        <th data-hook="admin_payout_profile_products_index_header_actions" class="actions"></th>
      </tr>
    </thead>
    <tbody id="sortVert">
      <% @payout_profile_products.each do |payout_profile_product| %>
          <td class="move-handle text-center">
            <%= svg_icon name: "sort.svg", width: '18', height: '18' %>
          </td>
          <td><%= link_to payout_profile_product.payout_profile&.name, edit_admin_payout_profile_path(payout_profile_product.payout_profile) if payout_profile_product.payout_profile&.present? %></td>
          <td class="text-center"><%= active_badge(payout_profile_product.payout_profile&.active) %></td>
          <td class="text-center"><%= active_badge(payout_profile_product.payout_profile&.verified_at) %></td>
          <td><%= payout_profile_product.payout_profile&.bank_account_number %></td>
          <td><%= pretty_time(payout_profile_product.created_at) %></td>
          <td data-hook="admin_payout_profile_products_index_row_actions" class="actions">
            <span class="d-flex justify-content-end">
              <%= link_to_delete(payout_profile_product, no_text: true) if can? :delete, payout_profile_product %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% else %>
  <div class="text-center no-objects-found m-5">
    <%= Spree.t(:no_resource_found, resource: plural_resource_name(Spree::PayoutProfileProduct)) %>,
    <%= link_to(Spree.t(:add_one), new_object_url) if can? :create, Spree::PayoutProfileProduct %>!
  </div>
<% end %>
