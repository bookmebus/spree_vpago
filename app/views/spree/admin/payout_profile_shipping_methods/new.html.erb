<%= render partial: 'spree/admin/shared/shipping_method_tabs', locals: { current: :payout_profile_shipping_methods } %>
<%= render partial: 'spree/admin/shared/error_messages', locals: { target: @payout_profile_shipping_method } %>

<% content_for :page_title do %>
  <%= link_to Spree.t(:shipping_methods), spree.admin_shipping_methods_url %> /
  <%= @shipping_method.name %>
<% end %>

<% content_for :page_actions do %>
  <%= button_link_to Spree.t(:add_profiles) + " (#{@shipping_method.vendor&.name})", admin_payout_profiles_url(q: { vendor_id_eq: @shipping_method.vendor_id }), icon: 'arrow-right-circle.svg' %>
<% end if @shipping_method.vendor.payout_profiles.any? %>

<% if @shipping_method.vendor.payout_profiles.none? %>
  <div class="alert alert-warning mb-3 d-flex justify-content-between align-items-center">
    To set up payouts for this product, make sure the vendor has a payout account linked
    <%= button_link_to Spree.t(:add_profiles) + " (#{@shipping_method.vendor&.name})", new_admin_payout_profile_url(vendor_id: @shipping_method.vendor_id), class: "btn-warning", icon: 'arrow-right-circle.svg' %>
  </div>
<% end %>

<%= form_for @payout_profile_shipping_method, url: collection_url do |f| %>
  <fieldset>
    <%= render partial: 'form', locals: { f: f } %>
    <div class="form-actions" data-hook="buttons">
      <%= button Spree.t('actions.create'), 'save.svg', 'submit', {class: 'btn-success', data: { disable_with: "#{ Spree.t(:saving) }..." }} %>
    <div>
  </fieldset>
<% end if @shipping_method.vendor.payout_profiles.any? %>
